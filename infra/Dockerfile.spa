# Сборка статического приложения из монорепо: docker build -f infra/Dockerfile.spa --build-arg APP=miniapp .
FROM node:22-alpine AS build
ARG APP
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/${APP}/package.json apps/${APP}/
RUN pnpm install --frozen-lockfile --filter "@auksion/${APP}..."
COPY packages/shared packages/shared
COPY apps/${APP} apps/${APP}
# Только публичные значения: всё из VITE_* попадает в бандл.
ARG VITE_DEMO_DATA=false
ENV VITE_DEMO_DATA=${VITE_DEMO_DATA}
RUN pnpm --filter "@auksion/${APP}" exec vite build

FROM nginxinc/nginx-unprivileged:1.27-alpine
ARG APP
ARG FRAME_ANCESTORS="'none'"
COPY infra/nginx/spa.conf /etc/nginx/conf.d/default.conf
RUN sed -i "s|__FRAME_ANCESTORS__|${FRAME_ANCESTORS}|g" /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/${APP}/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
