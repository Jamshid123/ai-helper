# Пример для локальной разработки. Секретов в git нет; на сервере значения — в /opt/auksion/.env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/auksion_dev
REDIS_URL=redis://127.0.0.1:56379
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# disabled | fake (только dev/test) | live
PAYMENTS_MODE=disabled
