# Пример для локальной разработки. Секретов в git нет; на сервере значения — в /opt/auksion/.env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/auksion_dev
REDIS_URL=redis://127.0.0.1:56379
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# disabled | fake (только dev/test) | live
PAYMENTS_MODE=disabled
# Демо-стенд: разрешает PAYMENTS_MODE=fake в production и скрипт тестовых лотов. В бою — false.
DEMO_STAND=false
# Токен бота (BotFather) и секрет сессий (>= 32 символов). Реальные значения — только на сервере.
TELEGRAM_BOT_TOKEN=123456:replace-me-xxxxxxxxxxxxxxxx
JWT_SECRET=replace-me-with-32-plus-random-characters
