# Пример для локальной разработки. Секретов в git нет; на сервере значения — в /opt/auksion/.env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/auksion_dev
REDIS_URL=redis://127.0.0.1:56379
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# disabled | fake (только dev/test) | live
PAYMENTS_MODE=disabled
# Демо-стенд: разрешает PAYMENTS_MODE=fake в production и скрипт тестовых лотов. В бою — false.
DEMO_STAND=false
# Платёжные системы (PAYMENTS_MODE=live). Покупателю предлагаются только настроенные.
# Click: выдаются при подключении кассы. SECRET_KEY — секрет, только в .env на сервере.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Payme: ID веб-кассы и ключ (в песочнице — TEST_KEY). Ключ — секрет.
PAYME_MERCHANT_ID=
PAYME_KEY=
# Песочница Payme (страница оплаты test.paycom.uz). В бою — false.
PAYME_TEST_MODE=false
# Запросы Payme принимаются только с их IP. В production выключить нельзя.
PAYME_IP_CHECK=true
# Куда вернуть покупателя со страницы оплаты (по умолчанию — первый из CORS_ORIGINS).
# PUBLIC_SITE_URL=https://auksion.expertly.uz
# Токен бота (BotFather) и секрет сессий (>= 32 символов). Реальные значения — только на сервере.
TELEGRAM_BOT_TOKEN=123456:replace-me-xxxxxxxxxxxxxxxx
JWT_SECRET=replace-me-with-32-plus-random-characters
# Ключ шифрования секретов в БД: openssl rand -hex 32 (на сервере генерируется при выкладке)
DATA_ENCRYPTION_KEY=
# Папка для фото товаров (в проде — том Docker /data/media)
MEDIA_DIR=./.media
# SMS для входа: disabled | fake (fake — только демо/разработка)
SMS_MODE=fake

# Ограничение частоты запросов (вход, предложения цены, допуск, оплата, лента торгов). В production выключить нельзя.
RATE_LIMIT_ENABLED=true
