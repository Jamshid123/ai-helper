// Схема БД AuksionGO. Деньги — BigInt (целые сумы), время — timestamptz (UTC).
// Модели добавляются по этапам docs/plans/backend-mvp.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Покупатели ─────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  telegramId      BigInt    @unique
  firstName       String
  lastName        String?
  username        String?
  /// Подтверждённый телефон (из message.contact бота). ПДн: не логировать, отдавать только владельцу/уполномоченным.
  phone           String?   @unique
  phoneVerifiedAt DateTime? @db.Timestamptz
  /// Публичное имя для ленты торгов: «Имя Ф.» или «Участник 0417».
  publicName      String
  rulesVersion    String?
  rulesAcceptedAt DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  admissions   Admission[]
  bids         Bid[]
  autoBids     AutoBid[]
  reminders    LotReminder[]
  orders       Order[]
  obligations  Obligation[]
  restrictions Restriction[]
}

/// Ограничение участия (невыкуп → 50 календарных дней). Снятие — только с причиной и аудитом.
model Restriction {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id])
  reason       String
  obligationId String?   @db.Uuid
  startsAt     DateTime  @db.Timestamptz
  endsAt       DateTime  @db.Timestamptz
  liftedAt     DateTime? @db.Timestamptz
  liftedBy     String?
  liftReason   String?
  createdAt    DateTime  @default(now()) @db.Timestamptz

  @@index([userId, endsAt])
}

// ───────────── Лоты и торги ─────────────

enum LotCondition {
  NEW
  USED
}

enum SellerType {
  PLATFORM
  EXTERNAL
}

enum LotStatus {
  DRAFT
  SCHEDULED
  LIVE
  CLOSED_SOLD
  CLOSED_UNSOLD
  UNDER_REVIEW
  CANCELLED
}

model Lot {
  id            String       @id @default(uuid()) @db.Uuid
  title         String
  categoryId    String       @db.Uuid
  category      Category     @relation(fields: [categoryId], references: [id])
  /// Товар, из которого создан лот (данные карточки копируются в лот и фиксируются после открытия торгов).
  productId     String?      @db.Uuid
  product       Product?     @relation(fields: [productId], references: [id])
  condition     LotCondition
  sellerType    SellerType   @default(PLATFORM)
  description   String       @default("")
  /// Акт проверки для карточки: summary, battery, imeiChecked, kit[], defects[]. Полный IMEI здесь не хранится.
  inspection    Json         @default("{}")
  startPrice    BigInt
  step          BigInt
  fee           BigInt
  currentPrice  BigInt?
  leaderUserId  String?      @db.Uuid
  /// Последний порядковый номер ставки (монотонный, меняется только под FOR UPDATE).
  lastSeq       Int          @default(0)
  admittedCount Int          @default(0)
  status        LotStatus    @default(DRAFT)
  opensAt       DateTime     @db.Timestamptz
  closesAt      DateTime     @db.Timestamptz
  closedAt      DateTime?    @db.Timestamptz
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz

  admissions  Admission[]
  bids        Bid[]
  autoBids    AutoBid[]
  reminders   LotReminder[]
  orders      Order[]
  obligations Obligation[]

  @@index([status, opensAt])
  @@index([categoryId])
}

/// Допуск к конкретному лоту. Один на пару (лот, пользователь).
model Admission {
  id        String   @id @default(uuid()) @db.Uuid
  lotId     String   @db.Uuid
  lot       Lot      @relation(fields: [lotId], references: [id])
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  orderId   String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([lotId, userId])
}

/// Принятое предложение цены. Неизменяемо.
model Bid {
  id             String   @id @default(uuid()) @db.Uuid
  lotId          String   @db.Uuid
  lot            Lot      @relation(fields: [lotId], references: [id])
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id])
  amount         BigInt
  seq            Int
  idempotencyKey String
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@unique([lotId, seq])
  @@unique([userId, idempotencyKey])
  @@index([lotId, amount(sort: Desc)])
}

/// Автопредложение до максимума (proxy bidding): система предлагает за участника на шаг выше,
/// пока не превышен его максимум. Максимум виден только владельцу. Одно на (лот, пользователь).
model AutoBid {
  id        String   @id @default(uuid()) @db.Uuid
  lotId     String   @db.Uuid
  lot       Lot      @relation(fields: [lotId], references: [id])
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  maxAmount BigInt
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([lotId, userId])
  @@index([lotId, active, maxAmount(sort: Desc)])
}

/// Напоминание о начале торгов по лоту (за N минут до открытия). Отправляется ровно один раз.
model LotReminder {
  id            String    @id @default(uuid()) @db.Uuid
  lotId         String    @db.Uuid
  lot           Lot       @relation(fields: [lotId], references: [id])
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id])
  minutesBefore Int
  remindAt      DateTime  @db.Timestamptz
  sentAt        DateTime? @db.Timestamptz
  createdAt     DateTime  @default(now()) @db.Timestamptz

  @@unique([lotId, userId])
  @@index([sentAt, remindAt])
}

// ───────────── Платежи и выкуп ─────────────

enum OrderPurpose {
  ADMISSION
  LISTING
  PREPAYMENT
  REMAINDER
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
  CANCELLED
}

model Order {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id])
  lotId        String       @db.Uuid
  lot          Lot          @relation(fields: [lotId], references: [id])
  purpose      OrderPurpose
  /// Сумма считается на сервере, в сумах.
  amount       BigInt
  status       OrderStatus  @default(PENDING)
  provider     String
  providerTxId String?      @unique
  paidAt       DateTime?    @db.Timestamptz
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz

  @@index([userId, lotId, purpose])
}

enum ObligationStatus {
  AWAITING_CONFIRMATION
  AWAITING_PREPAYMENT
  AWAITING_REMAINDER
  AWAITING_PICKUP
  COMPLETED
  EXPIRED
  CANCELLED
}

/// Предложение купить лот: победителю (rank 1) или следующему по рейтингу. Одно на (лот, место в очереди).
/// Продажа заключается только после подтверждения (confirmedAt) — лидерство само по себе не продажа.
model Obligation {
  id                 String           @id @default(uuid()) @db.Uuid
  lotId              String           @db.Uuid
  lot                Lot              @relation(fields: [lotId], references: [id])
  userId             String           @db.Uuid
  user               User             @relation(fields: [userId], references: [id])
  bidId              String           @db.Uuid
  rank               Int
  amount             BigInt
  prepaymentAmount   BigInt
  status             ObligationStatus @default(AWAITING_CONFIRMATION)
  /// Срок подтвердить покупку (15 мин).
  confirmDeadline    DateTime         @db.Timestamptz
  confirmedAt        DateTime?        @db.Timestamptz
  /// Срок оплаты 30% — назначается при подтверждении (2 ч).
  prepaymentDeadline DateTime?        @db.Timestamptz
  remainderDeadline  DateTime?        @db.Timestamptz
  /// Хэш одноразового кода выдачи (сам код показывается только покупателю).
  pickupCodeHash     String?
  createdAt          DateTime         @default(now()) @db.Timestamptz
  updatedAt          DateTime         @updatedAt @db.Timestamptz

  @@unique([lotId, rank])
  @@index([status, confirmDeadline])
  @@index([status, prepaymentDeadline])
}

// ───────────── Служебное ─────────────

/// Transactional outbox: событие пишется в той же транзакции, воркер публикует его в комнату/уведомления.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String
  aggregateId String
  payload     Json
  createdAt   DateTime  @default(now()) @db.Timestamptz
  publishedAt DateTime? @db.Timestamptz

  @@index([publishedAt, id])
}

/// Журнал аудита. Только вставка (права на UPDATE/DELETE у роли приложения отзываются миграцией).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  reason     String?
  meta       Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([entityType, entityId])
}

/// Настройки, которые меняются в админке без программиста (взнос, пункт выдачи…).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz
}

/// Роли сотрудников (ТЗ «Админка»). На старте выдаётся только ADMIN (решение 13.11.2026).
enum StaffRole {
  ADMIN
  OPERATOR
  EXPERT
  RISK
  FINANCE
  FULFILLMENT
  SUPPORT
}

/// Сотрудник админки: пароль (argon2id) + TOTP обязательны.
model Staff {
  id             String         @id @default(uuid()) @db.Uuid
  /// В нижнем регистре.
  email          String         @unique
  name           String
  passwordHash   String
  /// TOTP-секрет, зашифрованный DATA_ENCRYPTION_KEY (AES-256-GCM).
  totpSecretEnc  String
  /// null — код ещё не подключён: при первом входе сотрудник сканирует ключ и подтверждает первым кодом.
  totpEnrolledAt DateTime?      @db.Timestamptz
  /// Последний принятый шаг TOTP — один код нельзя использовать дважды.
  lastTotpStep   Int?
  roles          StaffRole[]
  failedLogins   Int            @default(0)
  lockedUntil    DateTime?      @db.Timestamptz
  disabledAt     DateTime?      @db.Timestamptz
  createdAt      DateTime       @default(now()) @db.Timestamptz
  updatedAt      DateTime       @updatedAt @db.Timestamptz
  sessions       StaffSession[]
}

/// Сессия админки (≤ 8 ч). В cookie — случайный токен, в БД — только его SHA-256.
model StaffSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  staffId   String    @db.Uuid
  staff     Staff     @relation(fields: [staffId], references: [id])
  csrfToken String
  ip        String?
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([staffId])
}

/// Категория каталога (решение 14.11.2026): названия ru/uz, выключенная не видна в Mini App вместе с её лотами.
model Category {
  id        String    @id @default(uuid()) @db.Uuid
  /// Неизменяемый код: phones, travel.
  slug      String    @unique
  nameRu    String
  nameUz    String
  enabled   Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  products  Product[]
  lots      Lot[]
}

enum ProductStatus {
  /// На складе, можно выставить.
  AVAILABLE
  /// Выставлен в лот (черновик, запланирован или идёт).
  IN_LOT
  SOLD
  ARCHIVED
}

/// Товар площадки: карточка и акт проверки. Лот создаётся из товара.
model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @db.Uuid
  category    Category      @relation(fields: [categoryId], references: [id])
  title       String
  condition   LotCondition
  description String        @default("")
  /// Акт для карточки: summary, battery, imeiChecked, kit[], defects[].
  inspection  Json          @default("{}")
  /// Полный IMEI/серийный номер — зашифрован (ТЗ: ограниченный доступ). В админке показываются последние 4 цифры.
  imeiEnc     String?
  imeiLast4   String?
  inventoryNo String?       @unique
  /// Себестоимость, сумы: стартовая цена лота не ниже (решение 13.11.2026).
  costPrice   BigInt?
  status      ProductStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz
  lots        Lot[]
}
