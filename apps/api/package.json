{
  "name": "@auksion/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate >/dev/null && tsc --noEmit",
    "test": "prisma generate >/dev/null && vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@auksion/shared": "workspace:*",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-fastify": "11.2.10",
    "@prisma/client": "6.19.3",
    "ioredis": "5.11.1",
    "jose": "6.2.14",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "11.2.10",
    "@swc/core": "1.16.22",
    "@types/node": "^25.9.9",
    "eslint": "^10.14.0",
    "fastify": "5.12.8",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-swc": "2.0.0",
    "vitest": "^4.1.12"
  }
}
