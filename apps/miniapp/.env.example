# Публичные значения — попадают в бандл. Секретов здесь быть не может.
VITE_API_URL=/api/v1
# true — всегда демо на тестовых данных. false — внутри Telegram данные API, в обычном браузере демо.
VITE_DEMO_DATA=true
# Тестовый запуск с API (сервер имитирует оплату): плашка «Тестовый запуск». В бою — false.
VITE_DEMO_STAND=false
